{
  "name": "gather",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "clean": "expo prebuild --clean",
    "prebuild": "expo prebuild --no-install",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "eslint-fix": "eslint --fix .",
    "typecheck": "tsc",
    "postinstall": "patch-package",
    "android": "expo run:android",
    "build-ios": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"./builds\" eas build -p ios --local --non-interactive",
    "submit-ios": "eas submit -p ios --non-interactive --path=\"./builds/$(ls -1 builds | sort | tail -n 1)\"",
    "build-and-submit-ios": "npm run build-ios && npm run submit-ios",
    "build-android": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"./android-builds\" eas build -p android --local --non-interactive",
    "submit-android": "eas submit -p android --non-interactive --path=\"./android-builds/$(ls -1 android-builds | sort | tail -n 1)\"",
    "build-and-submit-android": "npm run build-android && npm run submit-android"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.1.1",
    "@tanstack/react-query": "^5.101.4",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.10",
    "expo": "^53.0.27",
    "expo-application": "~6.1.5",
    "expo-auth-session": "~6.2.1",
    "expo-av": "~15.1.7",
    "expo-background-task": "~0.2.8",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-clipboard": "~7.1.5",
    "expo-config-plugin-ios-share-extension": "^0.0.4",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-document-picker": "~13.1.6",
    "expo-dynamic-app-icon": "^1.2.0",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-media-library": "~17.1.7",
    "expo-navigation-bar": "~4.2.8",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-store-review": "~8.1.5",
    "expo-system-ui": "~5.0.11",
    "expo-task-manager": "~13.1.6",
    "expo-web-browser": "~14.2.0",
    "patch-package": "^8.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-hold-menu": "^0.1.6",
    "react-native-iap": "^12.16.0",
    "react-native-ios-modal": "^0.1.8",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-mmkv": "^2.12.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-reanimated-carousel": "v4.0.0-canary.22",
    "react-native-receive-sharing-intent": "^2.0.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "react-native-zip-archive": "^7.0.1",
    "tamagui": "^1.123.3",
    "url-metadata": "3.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@tamagui/config": "^1.123.3",
    "@types/mocha": "^10.0.1",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^9.0.5",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.14",
    "react-test-renderer": "^19.0.0",
    "typescript": "~5.8.3",
    "uri-scheme": "^1.1.0"
  },
  "overrides": {
    "react-refresh": "~0.14.0",
    "@expo/config-plugins": "~10.1.1"
  },
  "resolutions": {
    "react-refresh": "~0.14.0"
  },
  "private": true
}
