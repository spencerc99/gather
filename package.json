{
  "name": "gather",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "clean": "expo prebuild --clean",
    "prebuild": "expo prebuild --no-install",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "eslint-fix": "eslint --fix .",
    "typecheck": "tsc",
    "postinstall": "patch-package",
    "android": "expo run:android",
    "build-ios": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"./builds\" eas build -p ios --local --non-interactive",
    "submit-ios": "eas submit -p ios --non-interactive --path=\"./builds/$(ls -1 builds | sort | tail -n 1)\"",
    "build-and-submit-ios": "npm run build-ios && npm run submit-ios",
    "build-android": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"./android-builds\" eas build -p android --local --non-interactive",
    "submit-android": "eas submit -p android --non-interactive --path=\"./android-builds/$(ls -1 android-builds | sort | tail -n 1)\"",
    "build-and-submit-android": "npm run build-android && npm run submit-android"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.1.1",
    "@tanstack/react-query": "^5.32.0",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.10",
    "expo": "^52.0.49",
    "expo-application": "~6.0.2",
    "expo-auth-session": "~6.0.3",
    "expo-av": "~15.0.2",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "~0.13.3",
    "expo-clipboard": "~7.0.1",
    "expo-config-plugin-ios-share-extension": "^0.0.4",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-document-picker": "~13.0.3",
    "expo-dynamic-app-icon": "^1.2.0",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-media-library": "~17.0.6",
    "expo-navigation-bar": "~4.0.9",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-store-review": "~8.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "patch-package": "^8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-get-random-values": "~1.11.0",
    "react-native-hold-menu": "^0.1.6",
    "react-native-iap": "^12.16.0",
    "react-native-ios-modal": "^0.1.8",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-mmkv": "^2.12.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-reanimated-carousel": "v4.0.0-canary.22",
    "react-native-receive-sharing-intent": "^2.0.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.10",
    "react-native-zip-archive": "^7.0.1",
    "tamagui": "^1.97.0",
    "url-metadata": "3.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@tamagui/config": "^1.97.0",
    "@types/mocha": "^10.0.1",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.0.2",
    "@types/uuid": "^9.0.5",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.6",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.3.3",
    "uri-scheme": "^1.1.0"
  },
  "overrides": {
    "react-refresh": "~0.14.0",
    "@expo/config-plugins": "~9.0.0"
  },
  "resolutions": {
    "react-refresh": "~0.14.0"
  },
  "private": true
}
